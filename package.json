{
  "name": "claude-sessions",
  "version": "1.0.0",
  "description": "Local browser for Claude Code sessions: read, search, clean up and continue transcripts stored in ~/.claude/projects",
  "license": "MIT",
  "keywords": ["claude", "claude-code", "transcripts", "sessions", "viewer"],
  "engines": { "node": ">=20" },
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"node server/index.js\" \"vite\"",
    "api": "node server/index.js",
    "build": "vite build",
    "preview": "concurrently -n api,web -c magenta,cyan \"node server/index.js\" \"vite preview\""
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.11",
    "vite": "^6.3.5"
  }
}
